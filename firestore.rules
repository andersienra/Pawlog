rules_version = '2';

// Pawlog: only the people on this list can read or write the shared logbook.
// Emails are compared lowercased. Everything outside pawlog/ is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'ander.sienra@gmail.com',
             'chloebuss@icloud.com'
           ];
    }

    match /pawlog/{document=**} {
      allow read, write: if allowed();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
